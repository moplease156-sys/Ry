-- 6. มองทะลุชื่อคน (ESP Name)
local BtnESP = createBtn("6. มองทะลุชื่อคน: OFF")
local function applyESP(p)
    if p ~= LocalPlayer and p.Character and not p.Character:FindFirstChild("FinESP") then
        local head = p.Character:FindFirstChild("Head")
        if head then
            local bbg = Instance.new("BillboardGui", head)
            bbg.Name = "FinESP"
            bbg.AlwaysOnTop = true
            bbg.Size = UDim2.new(0, 100, 0, 30)
            bbg.StudsOffset = Vector3.new(0, 2.5, 0)
            
            local txt = Instance.new("TextLabel", bbg)
            txt.Size = UDim2.new(1, 0, 1, 0)
            txt.BackgroundTransparency = 1
            txt.Text = p.DisplayName
            txt.TextColor3 = Color3.fromRGB(0, 255, 255)
            txt.Font = Enum.Font.SourceSansBold
            txt.TextSize = 14
            txt.TextStrokeTransparency = 0
        end
    end
end

BtnESP.MouseButton1Click:Connect(function()
    esp = not esp
    BtnESP.Text = "6. มองทะลุชื่อคน: " .. (esp and "ON" or "OFF")
    BtnESP.BackgroundColor3 = esp and Color3.fromRGB(0, 180, 100) or Color3.fromRGB(0, 120, 215)
    for _, p in pairs(Players:GetPlayers()) do
        if esp then
            applyESP(p)
        elseif p.Character and p.Character:FindFirstChild("Head") and p.Character.Head:FindFirstChild("FinESP") then
            p.Character.Head.FinESP:Destroy()
        end
    end
end)

