-- 3. หายตัว (คนอื่นมองไม่เห็น)
local BtnInvis = createBtn("3. หายตัว: OFF")
BtnInvis.MouseButton1Click:Connect(function()
    isInvisible = not isInvisible
    BtnInvis.Text = "3. หายตัว: " .. (isInvisible and "ON" or "OFF")
    BtnInvis.BackgroundColor3 = isInvisible and Color3.fromRGB(0, 180, 100) or Color3.fromRGB(0, 120, 215)
    
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        if isInvisible then
            local savedCF = char.HumanoidRootPart.CFrame
            char:MoveTo(Vector3.new(0, 100000, 0))
            task.wait(0.1)
            local clone = char.HumanoidRootPart:Clone()
            clone.Parent = char
            char.HumanoidRootPart:Destroy()
            char:MoveTo(savedCF.Position)
        else
            if char:FindFirstChild("Humanoid") then
                char.Humanoid.Health = 0
            end
        end
    end
end)

-- 4. ล็อคหัว
local BtnAim = createBtn("4. ล็อคหัว: OFF")
BtnAim.MouseButton1Click:Connect(function()
    aimbot = not aimbot
    BtnAim.Text = "4. ล็อคหัว: " .. (aimbot and "ON" or "OFF")
    BtnAim.BackgroundColor3 = aimbot and Color3.fromRGB(0, 180, 100) or Color3.fromRGB(0, 120, 215)
end)

RunService.RenderStepped:Connect(function()
    if aimbot then
        local cam = workspace.CurrentCamera
        local target = nil
        local dist = math.huge
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
                local pos, vis = cam:WorldToViewportPoint(p.Character.Head.Position)
                if vis then
                    local mDist = (Vector2.new(pos.X, pos.Y) - UserInputService:GetMouseLocation()).Magnitude
                    if mDist < dist then
                        dist = mDist
                        target = p
                    end
                end
            end
        end
        if target then
            cam.CFrame = CFrame.new(cam.CFrame.Position, target.Character.Head.Position)
        end
    end
end)

