FlyToggle.MouseButton1Click:Connect(function()
    flyActive = not flyActive
    FlyToggle.Text = "บิน V3: " .. (flyActive and "ON" or "OFF")
    FlyToggle.BackgroundColor3 = flyActive and Color3.fromRGB(0, 180, 100) or Color3.fromRGB(0, 120, 215)
    
    local char = LocalPlayer.Character
    if flyActive and char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        bodyVel = Instance.new("BodyVelocity", hrp)
        bodyVel.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bodyGyro = Instance.new("BodyGyro", hrp)
