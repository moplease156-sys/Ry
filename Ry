-- 10. กันโดนปลิว (Anti-Fling)
local BtnAntiFling = createBtn("10. กันโดนปลิว: OFF")
BtnAntiFling.MouseButton1Click:Connect(function()
    antiFling = not antiFling
    BtnAntiFling.Text = "10. กันโดนปลิว: " .. (antiFling and "ON" or "OFF")
    BtnAntiFling.BackgroundColor3 = antiFling and Color3.fromRGB(0, 180, 100) or Color3.fromRGB(0, 120, 215)
end)

RunService.Stepped:Connect(function()
    if antiFling then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                for _, part in pairs(p.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end
    end
end)
